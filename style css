:root {
    --navy: #06275c;
    --blue: #0a4da2;
    --blue-light: #1d78d4;
    --green: #69ad32;
    --aqua: #54c7df;
    --yellow: #f0b91c;

    --dark: #071426;
    --text: #24344d;
    --muted: #718096;

    --white: #ffffff;
    --light: #f5f9fd;
    --line: #e2eaf3;

    --shadow:
        0 20px 60px rgba(8, 39, 92, .10);

    --radius: 22px;
}

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: "Inter", sans-serif;
    color: var(--text);
    background: var(--white);
    overflow-x: hidden;
}

body.no-scroll {
    overflow: hidden;
}

img {
    max-width: 100%;
    display: block;
}

a {
    text-decoration: none;
    color: inherit;
}

button,
input,
select,
textarea {
    font: inherit;
}

button {
    cursor: pointer;
}

.container {
    width: min(1180px, 92%);
    margin: auto;
}


/* LOADER */

.loader {
    position: fixed;
    inset: 0;
    background: var(--navy);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    z-index: 9999;
    transition: opacity .5s, visibility .5s;
}

.loader.hide {
    opacity: 0;
    visibility: hidden;
}

.loader-logo {
    color: white;
    font-family: "Poppins", sans-serif;
    font-size: 42px;
    font-weight: 800;
    letter-spacing: 5px;
}

.loader-line {
    width: 100px;
    height: 3px;
    background: white;
    margin-top: 18px;
    animation: loading 1.2s infinite;
}

@keyframes loading {
    0% { transform: scaleX(.2); }
    50% { transform: scaleX(1); }
    100% { transform: scaleX(.2); }
}


/* HEADER */

.header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 1000;
    background: rgba(255,255,255,.90);
    backdrop-filter: blur(18px);
    border-bottom: 1px solid transparent;
    transition: .3s;
}

.header.scrolled {
    border-color: var(--line);
    box-shadow: 0 10px 30px rgba(0,0,0,.06);
}

.nav {
    height: 82px;
    display: flex;
    align-items: center;
    justify-content: space-between;
}

.brand {
    display: flex;
    align-items: center;
    gap: 10px;
}

.brand-mark {
    width: 42px;
    height: 42px;
    border-radius: 12px;
    background: linear-gradient(145deg, var(--navy), var(--blue));
    color: white;
    display: grid;
    place-items: center;
    font-size: 23px;
    font-weight: 800;
}

.brand strong {
    display: block;
    color: var(--navy);
    font-family: "Poppins";
    font-size: 22px;
    letter-spacing: 1px;
}

.brand small {
    display: block;
    font-size: 7px;
    color: var(--green);
    letter-spacing: .7px;
    font-weight: 700;
}

nav {
    display: flex;
    align-items: center;
    gap: 25px;
}

nav a {
    font-size: 13px;
    font-weight: 600;
    color: #31415a;
    transition: .3s;
}

nav a:hover {
    color: var(--blue);
}

.nav-whatsapp {
    background: #20b85a;
    color: white !important;
    padding: 11px 17px;
    border-radius: 30px;
}

.menu-btn {
    display: none;
    border: 0;
    background: none;
    font-size: 28px;
    color: var(--navy);
}


/* HERO */

.hero {
    min-height: 760px;
    padding-top: 82px;
    position: relative;
    overflow: hidden;
    background:
        linear-gradient(135deg, #f8fcff 0%, #eaf5ff 55%, #ffffff 100%);
}

.hero-bg {
    position: absolute;
    width: 650px;
    height: 650px;
    right: -200px;
    top: 40px;
    border-radius: 50%;
    background: radial-gradient(
        circle,
        rgba(60,178,211,.20),
        transparent 65%
    );
}

.hero-grid {
    min-height: 670px;
    display: grid;
    grid-template-columns: 1fr 1.05fr;
    align-items: center;
    gap: 50px;
}

.eyebrow,
.section-tag {
    color: var(--blue);
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 2px;
}

.hero h1 {
    font-family: "Poppins";
    font-size: clamp(48px, 6vw, 78px);
    line-height: .98;
    color: var(--navy);
    margin: 20px 0;
    letter-spacing: -3px;
}

.hero h1 span,
.section-heading h2 span,
.story-content h2 span,
.contact-info h2 span {
    display: block;
    color: var(--green);
}

.hero-subtitle {
    font-size: 21px;
    font-weight: 700;
    color: var(--blue);
    margin-bottom: 15px;
}

.hero-text {
    max-width: 540px;
    color: var(--muted);
    line-height: 1.8;
}

.hero-buttons {
    display: flex;
    gap: 13px;
    margin-top: 30px;
    flex-wrap: wrap;
}

.btn {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    gap: 12px;
    min-height: 52px;
    padding: 0 25px;
    border-radius: 14px;
    font-weight: 700;
    font-size: 14px;
    transition: .3s;
}

.btn-primary {
    color: white;
    background: var(--navy);
    box-shadow: 0 12px 30px rgba(6,39,92,.2);
}

.btn-primary:hover {
    transform: translateY(-3px);
    background: var(--blue);
}

.btn-outline {
    border: 1px solid #bfd0e3;
    color: var(--navy);
    background: white;
}

.btn-outline:hover {
    border-color: var(--blue);
    transform: translateY(-3px);
}

.rating-demo {
    display: flex;
    align-items: center;
    gap: 15px;
    margin-top: 32px;
}

.stars,
.big-stars {
    color: #eab21a;
    letter-spacing: 3px;
}

.rating-demo strong {
    font-size: 20px;
    color: var(--navy);
}

.rating-demo span,
.rating-demo small {
    display: block;
}

.rating-demo span {
    font-size: 12px;
    font-weight: 600;
}

.rating-demo small {
    color: var(--muted);
    font-size: 9px;
}

.hero-visual {
    position: relative;
}

.product-frame {
    position: relative;
    border-radius: 30px;
    overflow: hidden;
    box-shadow: 0 30px 80px rgba(6,39,92,.18);
    background: white;
    transform: rotate(1deg);
}

.product-frame img {
    width: 100%;
}

.glow {
    position: absolute;
    inset: 10% -5%;
    background: rgba(67,174,213,.25);
    filter: blur(70px);
    z-index: -1;
}

.floating-badge {
    position: absolute;
    padding: 12px 16px;
    background: rgba(255,255,255,.92);
    backdrop-filter: blur(10px);
    border-radius: 12px;
    box-shadow: var(--shadow);
    font-size: 11px;
    font-weight: 700;
}

.badge-one {
    left: -25px;
    top: 18%;
}

.badge-two {
    right: -20px;
    bottom: 12%;
}

.wave {
    position: absolute;
    bottom: -50px;
    left: -5%;
    width: 110%;
    height: 100px;
    background: white;
    border-radius: 50% 50% 0 0;
}


/* BENEFITS */

.benefits {
    background: var(--navy);
    color: white;
}

.benefits-grid {
    display: grid;
    grid-template-columns: repeat(6,1fr);
}

.benefit {
    min-height: 105px;
    padding: 20px 12px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 8px;
    text-align: center;
    border-right: 1px solid rgba(255,255,255,.12);
}

.benefit:last-child {
    border: 0;
}

.benefit span {
    font-size: 23px;
    color: #8bd94b;
}

.benefit strong {
    font-size: 10px;
    letter-spacing: .5px;
}


/* SECTIONS */

.section {
    padding: 110px 0;
}

.section-heading {
    max-width: 680px;
    margin-bottom: 55px;
}

.section-heading.center {
    margin-left: auto;
    margin-right: auto;
    text-align: center;
}

.section-heading h2,
.story-content h2,
.contact-info h2 {
    font-family: "Poppins";
    font-size: clamp(35px, 4vw, 54px);
    line-height: 1.1;
    color: var(--navy);
    margin-top: 15px;
    letter-spacing: -1.5px;
}

.section-heading p {
    color: var(--muted);
    margin-top: 18px;
}


/* STORY */

.story {
    background: var(--light);
}

.story-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
}

.story-image {
    border-radius: 28px;
    overflow: hidden;
    box-shadow: var(--shadow);
}

.story-content p {
    color: var(--muted);
    line-height: 1.8;
    margin-top: 22px;
}

.story-points {
    margin-top: 30px;
    display: grid;
    gap: 14px;
}

.story-points div {
    display: flex;
    align-items: center;
    gap: 15px;
}

.story-points span {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--navy);
    color: white;
    display: grid;
    place-items: center;
    font-size: 10px;
}


/* FILTERS */

.filters {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
    margin-bottom: 35px;
}

.filter {
    border: 1px solid var(--line);
    background: white;
    color: var(--text);
    padding: 11px 17px;
    border-radius: 30px;
    font-size: 12px;
    font-weight: 700;
    transition: .3s;
}

.filter:hover,
.filter.active {
    color: white;
    background: var(--navy);
    border-color: var(--navy);
}


/* PRODUCTS */

.product-grid {
    display: grid;
    grid-template-columns: repeat(3,1fr);
    gap: 25px;
}

.product-card {
    background: white;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    transition: .35s;
}

.product-card:hover {
    transform: translateY(-8px);
    box-shadow: var(--shadow);
}

.product-card.hidden {
    display: none;
}

.product-image {
    height: 245px;
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
}

.product-image::before {
    content: "";
    position: absolute;
    inset: 0;
    opacity: .65;
}

.product-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: .5s;
    position: relative;
    z-index: 1;
}

.product-card:hover .product-image img {
    transform: scale(1.05);
}

.product-image.blue::before {
    background: linear-gradient(135deg,#dff3ff,#a9d8fa);
}

.product-image.aqua::before {
    background: linear-gradient(135deg,#d8fbff,#8bdbea);
}

.product-image.purple::before {
    background: linear-gradient(135deg,#eee6ff,#cbb7ee);
}

.product-image.green::before {
    background: linear-gradient(135deg,#e4f6dc,#a5d78d);
}

.product-image.cyan::before {
    background: linear-gradient(135deg,#dcf8ff,#8bd8ed);
}

.product-image.yellow::before {
    background: linear-gradient(135deg,#fff7d7,#f3d978);
}

.product-label {
    position: absolute;
    top: 15px;
    left: 15px;
    z-index: 2;
    background: rgba(255,255,255,.92);
    color: var(--navy);
    padding: 7px 10px;
    border-radius: 8px;
    font-size: 9px;
    font-weight: 800;
}

.product-info {
    padding: 25px;
}

.category {
    color: var(--green);
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 1px;
}

.product-info h3 {
    font-family: "Poppins";
    color: var(--navy);
    font-size: 20px;
    margin: 8px 0;
}

.product-info p {
    color: var(--muted);
    font-size: 13px;
    line-height: 1.7;
}

.size {
    display: block;
    margin-top: 15px;
    color: var(--navy);
}

.product-btn {
    width: 100%;
    margin-top: 18px;
    padding: 13px;
    border: 0;
    border-radius: 11px;
    background: #edf5fc;
    color: var(--navy);
    font-weight: 800;
    transition: .3s;
}

.product-btn:hover {
    background: var(--navy);
    color: white;
}


/* WHY */

.why-section {
    background: var(--light);
}

.why-grid {
    display: grid;
    grid-template-columns: repeat(3,1fr);
    gap: 20px;
}

.why-card {
    padding: 32px;
    background: white;
    border: 1px solid var(--line);
    border-radius: 20px;
    transition: .3s;
}

.why-card:hover {
    transform: translateY(-5px);
    box-shadow: var(--shadow);
}

.icon {
    font-size: 30px;
    color: var(--blue);
}

.why-card h3 {
    color: var(--navy);
    font-family: "Poppins";
    margin: 20px 0 10px;
}

.why-card p {
    color: var(--muted);
    font-size: 13px;
    line-height: 1.7;
}


/* PROCESS */

.process-grid {
    display: grid;
    grid-template-columns: repeat(4,1fr);
    gap: 18px;
}

.process-card {
    padding: 30px;
    border: 1px solid var(--line);
    border-radius: 20px;
}

.process-card > span {
    color: var(--green);
    font-weight: 800;
}

.process-card h3 {
    color: var(--navy);
    margin: 25px 0 8px;
    font-family: "Poppins";
}

.process-card p {
    color: var(--muted);
    font-size: 13px;
    line-height: 1.6;
}


/* REVIEWS */

.reviews {
    background: #f7fbff;
}

.review-box {
    text-align: center;
    max-width: 700px;
    margin: auto;
    padding: 65px 30px;
    background: white;
    border: 1px solid var(--line);
    border-radius: 30px;
    box-shadow: var(--shadow);
}

.big-stars {
    font-size: 28px;
}

.review-number {
    color: var(--navy);
    font-family: "Poppins";
    font-size: 70px;
    font-weight: 800;
    margin-top: 10px;
}

.review-box h2 {
    color: var(--navy);
    font-family: "Poppins";
}

.review-box p {
    color: var(--muted);
    margin-top: 10px;
}

.review-box small {
    display: block;
    margin-top: 12px;
    color: #9aa6b6;
}


/* PROMISE */

.promise {
    min-height: 580px;
    position: relative;
    display: flex;
    align-items: center;
    overflow: hidden;
    background:
        linear-gradient(135deg,#031936,#075ea0);
}

.promise::before,
.promise::after {
    content: "";
    position: absolute;
    border-radius: 50%;
    border: 1px solid rgba(255,255,255,.12);
}

.promise::before {
    width: 600px;
    height: 600px;
    right: -200px;
    top: -200px;
}

.promise::after {
    width: 350px;
    height: 350px;
    left: -120px;
    bottom: -150px;
}

.promise-content {
    position: relative;
    z-index: 2;
    color: white;
}

.promise-content > span {
    font-size: 11px;
    letter-spacing: 3px;
    font-weight: 800;
}

.promise h2 {
    font-family: "Poppins";
    font-size: clamp(45px,7vw,80px);
    line-height: .98;
    margin: 22px 0;
    letter-spacing: -3px;
}

.promise h2 strong {
    color: #87d64d;
}

.promise p {
    color: rgba(255,255,255,.75);
    margin-bottom: 30px;
}

.btn-light {
    background: white;
    color: var(--navy);
}


/* CONTACT */

.contact {
    background: var(--light);
}

.contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: start;
}

.contact-info > p {
    color: var(--muted);
    line-height: 1.8;
    margin: 22px 0 35px;
    max-width: 500px;
}

.contact-item {
    display: flex;
    gap: 16px;
    margin: 20px 0;
}

.contact-item > span {
    width: 45px;
    height: 45px;
    background: white;
    border-radius: 12px;
    display: grid;
    place-items: center;
    color: var(--blue);
    box-shadow: 0 5px 20px rgba(0,0,0,.05);
}

.contact-item small,
.contact-item strong,
.contact-item a {
    display: block;
}

.contact-item small {
    color: var(--muted);
    font-size: 10px;
    margin-bottom: 4px;
}

.contact-item a,
.contact-item strong {
    color: var(--navy);
    font-size: 14px;
}

.map-btn {
    display: inline-block;
    margin-top: 10px;
    color: var(--blue);
    font-weight: 800;
    font-size: 13px;
}


/* FORM */

.contact-form {
    background: white;
    padding: 35px;
    border-radius: 25px;
    box-shadow: var(--shadow);
}

.contact-form h3 {
    font-family: "Poppins";
    color: var(--navy);
    font-size: 25px;
}

.contact-form > p {
    color: var(--muted);
    font-size: 13px;
    margin: 8px 0 25px;
}

.contact-form label {
    display: block;
    color: var(--navy);
    font-size: 12px;
    font-weight: 700;
    margin-top: 17px;
}

.contact-form input,
.contact-form select,
.contact-form textarea {
    width: 100%;
    margin-top: 8px;
    padding: 14px;
    border: 1px solid var(--line);
    border-radius: 10px;
    outline: none;
    color: var(--text);
    background: #fbfdff;
    resize: vertical;
}

.contact-form input:focus,
.contact-form select:focus,
.contact-form textarea:focus {
    border-color: var(--blue);
}

.submit-btn {
    width: 100%;
    border: 0;
    margin-top: 22px;
    padding: 15px;
    border-radius: 12px;
    background: #20b85a;
    color: white;
    font-weight: 800;
    transition: .3s;
}

.submit-btn:hover {
    background: #159447;
    transform: translateY(-2px);
}


/* FOOTER */

footer {
    background: #04152f;
    color: white;
    padding-top: 70px;
}

.footer-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr;
    gap: 60px;
    padding-bottom: 50px;
}

.footer-brand {
    font-family: "Poppins";
    font-size: 30px;
    font-weight: 800;
    letter-spacing: 2px;
}

.footer-grid p {
    margin: 8px 0;
    color: #82d148;
    font-size: 11px;
}

.footer-grid span {
    color: #9aa9bd;
    font-size: 12px;
}

.footer-grid h4 {
    margin-bottom: 20px;
}

.footer-grid a {
    display: block;
    color: #aebbd0;
    font-size: 12px;
    margin: 10px 0;
}

.footer-grid a:hover {
    color: white;
}

.footer-bottom {
    padding: 20px 4%;
    border-top: 1px solid rgba(255,255,255,.1);
    color: #7e8ca1;
    font-size: 10px;
    display: flex;
    justify-content: space-between;
}


/* FLOATING BUTTONS */

.floating-whatsapp {
    position: fixed;
    right: 22px;
    bottom: 22px;
    width: 58px;
    height: 58px;
    border-radius: 50%;
    background: #20b85a;
    color: white;
    display: grid;
    place-items: center;
    font-size: 27px;
    z-index: 800;
    box-shadow: 0 10px 30px rgba(32,184,90,.35);
    animation: pulse 2.3s infinite;
}

@keyframes pulse {
    0%,100% {
        box-shadow: 0 10px 30px rgba(32,184,90,.3);
    }

    50% {
        box-shadow: 0 10px 40px rgba(32,184,90,.65);
    }
}

.top-btn {
    position: fixed;
    right: 22px;
    bottom: 92px;
    width: 42px;
    height: 42px;
    border: 0;
    border-radius: 12px;
    background: var(--navy);
    color: white;
    z-index: 700;
    opacity: 0;
    visibility: hidden;
    transition: .3s;
}

.top-btn.show {
    opacity: 1;
    visibility: visible;
}


/* MODAL */

.modal {
    position: fixed;
    inset: 0;
    background: rgba(2,16,35,.72);
    backdrop-filter: blur(8px);
    display: grid;
    place-items: center;
    padding: 20px;
    z-index: 3000;
    opacity: 0;
    visibility: hidden;
    transition: .3s;
}

.modal.open {
    opacity: 1;
    visibility: visible;
}

.modal-box {
    position: relative;
    width: min(850px,100%);
    background: white;
    border-radius: 25px;
    overflow: hidden;
    display: grid;
    grid-template-columns: 1fr 1fr;
    transform: translateY(25px);
    transition: .3s;
}

.modal.open .modal-box {
    transform: translateY(0);
}

.modal-image {
    background: #eef7ff;
}

.modal-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.modal-content {
    padding: 45px;
}

.modal-content > span {
    color: var(--green);
    font-size: 10px;
    font-weight: 800;
}

.modal-content h2 {
    font-family: "Poppins";
    color: var(--navy);
    font-size: 32px;
    margin: 12px 0;
}

.modal-content p {
    color: var(--muted);
    line-height: 1.7;
    margin-bottom: 25px;
}

.modal-close {
    position: absolute;
    top: 15px;
    right: 15px;
    width: 38px;
    height: 38px;
    border: 0;
    border-radius: 50%;
